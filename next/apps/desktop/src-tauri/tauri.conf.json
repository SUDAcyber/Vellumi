{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellumi Next",
  "version": "0.1.0",
  "identifier": "com.aaron.vellumi.next",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Aaron. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Editor",
        "contentTypes": ["net.daringfireball.markdown"]
      },
      {
        "ext": ["txt"],
        "name": "Plain Text",
        "role": "Editor",
        "contentTypes": ["public.plain-text"]
      }
    ]
  }
}
